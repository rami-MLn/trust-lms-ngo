# Server Configuration
PORT=5000
NODE_ENV=development

# Database (SQLite file path)
DB_PATH=./data/trust_lms.db

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Vercel deployment: set to your custom domain
# FRONTEND_URL=https://training.trust-ngo.org
